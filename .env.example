# ===== 必要設定 =====
DISCORD_TOKEN=your_discord_bot_token
BASE_URL=https://api.example.com/v1
API_KEY=your_api_key
MODEL=your_model

# Docker Compose 啟動 SearXNG 時必填，執行 ./setup.sh 會自動產生
SEARXNG_SECRET=

# ===== 長期記憶（留空則停用）=====
# 若 Mem0 跑在主機上，Docker 內請使用 http://host.docker.internal:8888
MEM0_BASE_URL=

# ===== 選用設定（以下為預設值）=====
# FALLBACK_MODEL=
# MODEL_TEMPERATURE=
# AI_TIMEOUT=90
# AI_MAX_TURNS=10
# AI_MAX_RUNS=2
# TOOL_CALL_BUDGET=24
# ENABLE_RESEARCH=true
# RESEARCH_MAX_TURNS=12
# DISABLED_TOOLS=
# REMINDER_PING=true
# STREAM_RESPONSES=true
# STREAM_EDIT_INTERVAL=1.2
# SHOW_STATE_EMBED=false
# ENABLE_VISION=true
# MAX_ATTACHMENTS=4
# STATE_DECAY_ENABLED=true
# STATE_DECAY_AFTER_DAYS=3
# STATE_DECAY_AMOUNT=1
# MAX_CONCURRENT_REQUESTS=8
# RATE_LIMIT_PER_USER=3
# RATE_LIMIT_WINDOW=60
# RESPOND_TO_DM=true
# RESPOND_TO_REPLIES=true
# SEARCH_LANGUAGE=zh-TW
# SEARCH_MAX_RESULTS=5
# LOG_LEVEL=INFO
